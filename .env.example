# ==============================================================================
# PCChiaro.it - Environment Configuration Example
# ==============================================================================
# ISTRUZIONI:
# 1. Copia questo file in `.env.local`: `cp .env.example .env.local`
# 2. Non inserire credenziali o segreti reali in questo file né committarli in Git.
# 3. Per generare un SESSION_SECRET sicuro da terminale (almeno 32 caratteri casuali):
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Per generare l'hash della password di amministrazione (Argon2id o Scrypt):
#    node -e "const crypto=require('crypto'); const salt=crypto.randomBytes(16).toString('hex'); crypto.scrypt('TUA_PASSWORD', salt, 64, (err, key) => console.log(salt + ':' + key.toString('hex')))"
# ==============================================================================

# Database SQLite path (storage persistente su disco locale/volume)
DATABASE_URL="./data/pcchiaro.db"

# Ambiente applicativo (development, production, test)
NODE_ENV="development"

# URL base dell'applicazione
NEXT_PUBLIC_SITE_URL="https://pcchiaro.domcibstudios.workers.dev"

# Credenziali Amministratore Singolo (Solo server-side)
ADMIN_USERNAME="admin"
# Formato hash: salt:derivedKey (generato con lo script di istruzione sopra)
ADMIN_PASSWORD_HASH="placeholder_salt:placeholder_derived_key"

# Segreto per la firma e crittografia della sessione HTTP-Only (min. 32 caratteri)
SESSION_SECRET="placeholder_session_secret_at_least_32_chars_long_random"

# Configurazione Cookies di Sessione
SESSION_COOKIE_NAME="pcchiaro_session"
# In produzione impostare sempre SECURE_COOKIE="true"
SECURE_COOKIE="false"
# Durata massima sessione in secondi (es. 86400 = 24 ore)
SESSION_MAX_AGE="86400"

# Tag di Affiliazione Amazon Associates Centralizzato
# Lasciare vuoto finché l'account Amazon non è approvato.
# Può anche essere modificato/impostato direttamente dal pannello Admin (/admin/prices).
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=""
